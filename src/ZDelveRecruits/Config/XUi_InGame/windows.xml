      <label name="page" pos="20,-225" width="420" height="30" text="{nr_page}" font_size="19" depth="5" color="230,225,210" justify="left" pivot="topleft" />
      <simplebutton name="nr_row0" pos="20,-260" width="410" height="36" caption="{nr_row0}" font_size="18" depth="4" defaultcolor="38,49,60" hovercolor="67,84,96" />
