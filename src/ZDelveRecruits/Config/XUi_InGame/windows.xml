      <simplebutton name="nr_row3" pos="20,-380" width="410" height="36" caption="{nr_row3}" font_size="18" depth="4" defaultcolor="38,49,60" hovercolor="67,84,96" />
      <simplebutton name="nr_row4" pos="20,-420" width="410" height="36" caption="{nr_row4}" font_size="18" depth="4" defaultcolor="38,49,60" hovercolor="67,84,96" />
      <simplebutton name="nr_row5" pos="20,-460" width="410" height="36" caption="{nr_row5}" font_size="18" depth="4" defaultcolor="38,49,60" hovercolor="67,84,96" />
      <simplebutton name="nr_row6" pos="20,-500" width="410" height="36" caption="{nr_row6}" font_size="18" depth="4" defaultcolor="38,49,60" hovercolor="67,84,96" />
