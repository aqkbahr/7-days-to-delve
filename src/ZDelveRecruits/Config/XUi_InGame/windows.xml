<?xml version='1.0' encoding='utf-8'?>
<configs>
  <append xpath="/windows">
    <window name="delveRecruitWindow" anchor="Center" pos="-550,350" width="1100" height="700" controller="Delve.XUiC_RecruitScreen, Delve" cursor_area="true">
      <sprite name="background" width="1100" height="700" sprite="menu_empty" color="17,25,33,250" depth="1" type="sliced" />
      <label name="title" pos="20,-15" width="900" height="40" text="WAYREST / SETTLEMENT RECRUITS" font_size="28" depth="5" color="230,225,210" justify="left" pivot="topleft" />
      <simplebutton name="nr_close" pos="1030,-15" width="50" height="36" caption="X" font_size="18" depth="4" defaultcolor="38,49,60" hovercolor="67,84,96" />
      <simplebutton name="nr_settlement" pos="20,-65" width="690" height="36" caption="{nr_settlement}" font_size="18" depth="4" defaultcolor="38,49,60" hovercolor="67,84,96" />
      <simplebutton name="nr_refresh" pos="730,-65" width="160" height="36" caption="Refresh" font_size="18" depth="4" defaultcolor="38,49,60" hovercolor="67,84,96" />
      <label name="intro" pos="20,-110" width="1060" height="65" text="Deposit gold in your Settlement Ledger and close its storage before hiring.&#10;Tier 1: Smith 400 gold | Cook 250 gold | Defender 500 gold. Hiring creates a reserve recruit." font_size="19" depth="5" color="230,225,210" justify="left" pivot="topleft" />
      <simplebutton name="nr_hireSmith" pos="20,-175" width="210" height="36" caption="Hire smith / 400" font_size="18" depth="4" defaultcolor="38,49,60" hovercolor="67,84,96" />
