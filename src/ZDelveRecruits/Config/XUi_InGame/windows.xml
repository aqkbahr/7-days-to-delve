      <simplebutton name="nr_prev" pos="20,-590" width="195" height="36" caption="Previous" font_size="18" depth="4" defaultcolor="38,49,60" hovercolor="67,84,96" />
      <simplebutton name="nr_next" pos="235,-590" width="195" height="36" caption="Next" font_size="18" depth="4" defaultcolor="38,49,60" hovercolor="67,84,96" />
