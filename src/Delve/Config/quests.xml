      </objective>
      <objective type="Craft" id="delveHealingPoultice" value="1" phase="2">
        <property name="item" value="delveHealingPoultice" />
        <property name="count" value="1" />
      </objective>
      <reward type="Exp" value="500" />
      <reward type="Item" id="casinoCoin" value="100" />
      <reward type="Item" id="medicalBandage" value="3" />
      <reward type="Quest" id="delveHearth" />
    </quest>
    <quest id="delveHearth">
      <property name="name_key" value="delveHearth" />
