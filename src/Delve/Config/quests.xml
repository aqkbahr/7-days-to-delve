      <property name="category_key" value="delveQuestCategory" />
      <property name="repeatable" value="false" />
      <property name="shareable" value="false" />
      <property name="add_to_tier_complete" value="false" />
      <property name="completiontype" value="AutoComplete" />
      <objective type="Craft" id="keystoneBlock" value="1" phase="1">
        <property name="item" value="keystoneBlock" />
        <property name="count" value="1" />
      </objective>
      <objective type="Craft" id="bedroll" value="1" phase="1">
        <property name="item" value="bedroll" />
        <property name="count" value="1" />
      </objective>
      <objective type="Craft" id="campfire" value="1" phase="1">
        <property name="item" value="campfire" />
        <property name="count" value="1" />
      </objective>
      <reward type="Exp" value="500" />
      <reward type="Item" id="casinoCoin" value="150" />
