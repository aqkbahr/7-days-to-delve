<?xml version='1.0' encoding='utf-8'?>
<configs>
  <append xpath="/quests">
    <quest id="delveArrival">
      <property name="name_key" value="delveArrival" />
      <property name="subtitle_key" value="delveArrivalSub" />
      <property name="description_key" value="delveArrivalDesc" />
      <property name="offer_key" value="delveArrivalDesc" />
      <property name="icon" value="ui_game_symbol_hammer" />
      <property name="category_key" value="delveQuestCategory" />
      <property name="repeatable" value="false" />
      <property name="shareable" value="false" />
      <property name="add_to_tier_complete" value="false" />
      <property name="completiontype" value="AutoComplete" />
      <objective type="FetchKeep" id="resourceWood" value="20" phase="1" />
      <objective type="FetchKeep" id="resourceRockSmall" value="10" phase="1" />
      <objective type="FetchKeep" id="resourceYuccaFibers" value="20" phase="1" />
      <objective type="Craft" id="delveBoneDagger" value="1" phase="2">
        <property name="item" value="delveBoneDagger" />
